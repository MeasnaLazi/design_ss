{
  "defaultMode": "acceptEdits",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash",
      "WebFetch"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(python -c*)",
      "Bash(python3 -c*)",
      "Bash(python3.11 -c*)",
      "Bash(toolkit/.venv/bin/python -c*)",
      "Read(web_ui/src/**)",
      "Edit(web_ui/src/**)",
      "Write(web_ui/src/**)"
    ]
  }
}
