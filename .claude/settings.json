{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "defaultMode": "acceptEdits",
  "permissions": {
    "allow": [
      "Bash(node composer/check-schema.mjs *)",
      "Bash(node composer/render.mjs *)",
      "Bash(node composer/pick-frame.mjs *)",
      "Bash(node check-schema.mjs *)",
      "Bash(node render.mjs *)",
      "Bash(node pick-frame.mjs *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run check)",
      "Bash(npm run check *)",
      "Bash(npm run dev)",
      "Bash(npm run typecheck)",
      "Bash(npm install)",
      "Bash(npm install *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)"
    ]
  }
}
